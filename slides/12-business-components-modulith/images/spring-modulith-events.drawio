        <mxCell id="event-listener" value="&lt;b&gt;MaklervertragEventListener&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- repository: VermittlungsvorgangRepository&lt;hr size=&quot;1&quot;/&gt;&lt;b&gt;@EventListener&lt;/b&gt;&lt;br/&gt;+ on(event: MaklervertragAbgeschlossen): void {&lt;br/&gt;&amp;nbsp;&amp;nbsp;var vorgang = Vermittlungsvorgang&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;.starten(event.getMaklervertragId());&lt;br/&gt;&amp;nbsp;&amp;nbsp;repository.save(vorgang);&lt;br/&gt;}" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;overflow=fill;" vertex="1" parent="1">
