          <mxGeometry x="140" y="425" width="100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="akquise-service" value="&lt;b&gt;AkquiseAppService&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- repository: MaklervertragRepository&lt;br/&gt;- eventPublisher: ApplicationEventPublisher&lt;hr size=&quot;1&quot;/&gt;+ maklervertragAbschliessen(cmd): void {&lt;br/&gt;&amp;nbsp;&amp;nbsp;var v = repository.findById(cmd.id());&lt;br/&gt;&amp;nbsp;&amp;nbsp;v.abschliessen();&lt;br/&gt;&amp;nbsp;&amp;nbsp;repository.save(v);&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;eventPublisher.publishEvent(&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;new MaklervertragAbgeschlossen(v.getId()));&lt;/b&gt;&lt;br/&gt;}" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="145" y="450" width="350" height="120" as="geometry" />
        </mxCell>

        <!-- Event class -->
        <mxCell id="event-class" value="&lt;b&gt;&amp;laquo;Domain Event&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;MaklervertragAbgeschlossen&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- maklervertragId: UUID&lt;br/&gt;- zeitpunkt: Instant" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=11;align=center;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="170" y="610" width="300" height="90" as="geometry" />
