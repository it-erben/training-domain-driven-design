        <mxCell id="maklervertrag" value="&lt;b&gt;Maklervertrag&lt;/b&gt;&lt;br/&gt;(Aggregate Root)&lt;hr size=&quot;1&quot;/&gt;- id: UUID&lt;br/&gt;- eigentuemer: Eigentuemer&lt;br/&gt;- immobilie: Immobilie&lt;br/&gt;- status: VertragStatus&lt;hr size=&quot;1&quot;/&gt;+ abschliessen(): void" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;align=left;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="180" y="230" width="280" height="155" as="geometry" />
        </mxCell>

        <!-- Akquise Application Service -->
