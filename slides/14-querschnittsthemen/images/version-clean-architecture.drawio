        <!-- Bottom note -->
        <mxCell id="note" value="&lt;b&gt;Kernregel:&lt;/b&gt; Die Domain hat ein einfaches &lt;code&gt;int version&lt;/code&gt; – der Mapper uebertraegt die Version in beide Richtungen.&lt;br/&gt;JPA prueft automatisch beim UPDATE: &lt;code&gt;WHERE version = ?&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
