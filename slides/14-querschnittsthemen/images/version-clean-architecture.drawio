        <mxCell id="domain-content" value="&lt;div style='text-align:left;font-family:monospace;font-size:12px;'&gt;&lt;span style='color:#7f7f7f;'&gt;// Reines Java – keine JPA-Annotationen&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;b style='color:#7b1fa2;'&gt;class&lt;/b&gt; BrokerageProcess {&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b style='color:#7b1fa2;'&gt;private final&lt;/b&gt; ProcessId id;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b style='color:#7b1fa2;'&gt;private int&lt;/b&gt; version;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;span style='color:#7f7f7f;'&gt;// Business logic&lt;/span&gt;&lt;br/&gt;}&lt;/div&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;" vertex="1" parent="1">
