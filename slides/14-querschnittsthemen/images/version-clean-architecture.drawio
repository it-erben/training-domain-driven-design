        <mxCell id="infra-content" value="&lt;div style='text-align:left;font-family:monospace;font-size:12px;'&gt;&lt;span style='color:#e65100;'&gt;@Entity&lt;/span&gt;&lt;br/&gt;&lt;b style='color:#7b1fa2;'&gt;class&lt;/b&gt; ProcessJpaEntity {&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;span style='color:#e65100;'&gt;@Id&lt;/span&gt; UUID id;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;span style='color:#e65100;'&gt;@Version&lt;/span&gt; Long version;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;span style='color:#7f7f7f;'&gt;// JPA fields&lt;/span&gt;&lt;br/&gt;}&lt;/div&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;" vertex="1" parent="1">
