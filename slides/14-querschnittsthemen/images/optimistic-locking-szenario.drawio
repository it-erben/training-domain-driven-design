        <!-- Actor B -->
        <mxCell id="actorB-icon" value="Makler B" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="80" width="40" height="60" as="geometry" />
