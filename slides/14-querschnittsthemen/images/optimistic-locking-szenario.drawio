        <!-- Lifeline A -->
        <mxCell id="lifeA" value="" style="endArrow=none;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="160" as="sourcePoint" />
            <mxPoint x="220" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Lifeline B -->
        <mxCell id="lifeB" value="" style="endArrow=none;dashed=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="160" as="sourcePoint" />
            <mxPoint x="820" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Database -->
        <mxCell id="db" value="&lt;b&gt;Datenbank&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- DB Lifeline -->
        <mxCell id="lifeDB" value="" style="endArrow=none;dashed=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="160" as="sourcePoint" />
            <mxPoint x="530" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 1: A loads -->
        <mxCell id="step1" value="laedt Vorgang #42" style="html=1;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="200" as="sourcePoint" />
            <mxPoint x="530" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step1r" value="Version 1" style="html=1;verticalAlign=middle;endArrow=block;endFill=1;dashed=1;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="230" as="sourcePoint" />
            <mxPoint x="220" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 2: B loads -->
        <mxCell id="step2" value="laedt Vorgang #42" style="html=1;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="280" as="sourcePoint" />
            <mxPoint x="530" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step2r" value="Version 1" style="html=1;verticalAlign=middle;endArrow=block;endFill=1;dashed=1;strokeColor=#d6b656;strokeWidth=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="310" as="sourcePoint" />
            <mxPoint x="820" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 3: A modifies -->
        <mxCell id="step3-note" value="&lt;i&gt;aendert Besichtigung&lt;/i&gt;" style="text;html=1;fontSize=11;align=left;fillColor=none;strokeColor=none;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="155" height="25" as="geometry" />
        </mxCell>

        <!-- Step 4: A saves successfully -->
        <mxCell id="step4" value="speichert (WHERE version=1)" style="html=1;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="420" as="sourcePoint" />
            <mxPoint x="530" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step4r" value="&lt;b&gt;Version 2&lt;/b&gt;" style="html=1;verticalAlign=middle;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="450" as="sourcePoint" />
            <mxPoint x="220" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step4-ok" value="&#x2705;" style="text;html=1;fontSize=18;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="170" y="455" width="40" height="30" as="geometry" />
        </mxCell>

        <!-- Step 5: B modifies -->
        <mxCell id="step5-note" value="&lt;i&gt;aendert Angebot&lt;/i&gt;" style="text;html=1;fontSize=11;align=right;fillColor=none;strokeColor=none;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="830" y="370" width="140" height="25" as="geometry" />
        </mxCell>

        <!-- Step 6: B tries to save - CONFLICT -->
        <mxCell id="step6" value="speichert (WHERE version=1)" style="html=1;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="530" as="sourcePoint" />
            <mxPoint x="530" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step6r" value="&lt;b&gt;KONFLIKT!&lt;/b&gt;" style="html=1;verticalAlign=middle;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontColor=#b85450;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="560" as="sourcePoint" />
            <mxPoint x="820" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step6-fail" value="&#x274C;" style="text;html=1;fontSize=18;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="830" y="565" width="40" height="30" as="geometry" />
        </mxCell>

        <!-- Explanation box -->
        <mxCell id="explain" value="&lt;b&gt;OptimisticLockException&lt;/b&gt;&lt;br/&gt;Erwartet Version 1, aber DB hat bereits Version 2&lt;br/&gt;→ 0 Rows affected → Exception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="620" y="610" width="310" height="60" as="geometry" />
