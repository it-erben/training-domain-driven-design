<mxfile host="draw.io">
  <diagram name="Mapping zwischen Schichten" id="mapping-layers-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Mapping zwischen Schichten" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="15" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- Layer labels (top row) -->
        <mxCell id="lbl-http" value="&lt;b&gt;HTTP-Request&lt;/b&gt;" style="text;html=1;fontSize=12;align=center;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="80" y="65" width="160" height="25" as="geometry" />
        </mxCell>
        <mxCell id="lbl-command" value="&lt;b&gt;Command&lt;/b&gt;" style="text;html=1;fontSize=12;align=center;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="65" width="160" height="25" as="geometry" />
        </mxCell>
        <mxCell id="lbl-domain" value="&lt;b&gt;Domain&lt;/b&gt;" style="text;html=1;fontSize=12;align=center;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="680" y="65" width="160" height="25" as="geometry" />
        </mxCell>
        <mxCell id="lbl-jpa" value="&lt;b&gt;JPA-Entity&lt;/b&gt;" style="text;html=1;fontSize=12;align=center;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="980" y="65" width="160" height="25" as="geometry" />
        </mxCell>

        <!-- ==================== TOP ROW (Request flow) ==================== -->

        <!-- Request DTO box -->
        <mxCell id="req-dto" value="&lt;b&gt;Request DTO&lt;/b&gt;&lt;br&gt;(JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Schedule Viewing Command box -->
        <mxCell id="cmd-box" value="&lt;b&gt;Schedule&lt;br&gt;Viewing&lt;br&gt;Command&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Brokerage Process box -->
