          </mxGeometry>
        </mxCell>
        <mxCell id="arrow-ret2" value="&lt;b&gt;Map&lt;/b&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;align=center;" edge="1" parent="1">
