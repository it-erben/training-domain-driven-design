        <mxCell id="domain-method" value="&lt;b&gt;Domain&lt;br&gt;Methode&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="680" y="280" width="160" height="80" as="geometry" />
