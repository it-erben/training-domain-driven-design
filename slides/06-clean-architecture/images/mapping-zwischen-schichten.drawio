          <mxGeometry x="80" y="280" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Bottom row arrows (right to left, return flow) -->
        <mxCell id="arrow-ret1" value="" style="endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
