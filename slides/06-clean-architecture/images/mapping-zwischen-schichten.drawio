        <!-- Layer color bars at bottom -->
        <mxCell id="bar-adapter" value="&lt;b&gt;Adapter&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;align=center;fontColor=#d6b656;" vertex="1" parent="1">
