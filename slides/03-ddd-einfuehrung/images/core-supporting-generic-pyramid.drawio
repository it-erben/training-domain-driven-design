<mxfile host="draw.io">
  <diagram name="Core Supporting Generic Pyramid" id="csg-pyramid-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Arrow on the left: Geschaeftswert / Differenzierung -->
        <mxCell id="arrow-line" value="" style="endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="520" as="sourcePoint" />
            <mxPoint x="200" y="100" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arrow-label" value="&lt;b&gt;Geschaeftswert / Differenzierung&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="250" height="30" as="geometry" />
        </mxCell>

        <!-- CORE block (top, green) -->
        <mxCell id="core-block" value="&lt;b&gt;CORE&lt;/b&gt;" style="html=1;rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=16;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="240" y="130" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="core-desc" value="&lt;b&gt;Volles DDD, Rich Domain Model, eigener Code&lt;/b&gt;&lt;br/&gt;Vermittlungsprozess, Akquise" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="490" y="140" width="420" height="100" as="geometry" />
        </mxCell>

        <!-- SUPPORTING block (middle, yellow) -->
        <mxCell id="supporting-block" value="&lt;b&gt;SUPPORTING&lt;/b&gt;" style="html=1;rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=16;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="240" y="260" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="supporting-desc" value="&lt;b&gt;Solides Modell, aber weniger Aufwand&lt;/b&gt;&lt;br/&gt;Vermarktung, Objektverwaltung" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="490" y="270" width="420" height="100" as="geometry" />
        </mxCell>

        <!-- GENERIC block (bottom, gray) -->
        <mxCell id="generic-block" value="&lt;b&gt;GENERIC&lt;/b&gt;" style="html=1;rounded=0;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=16;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="240" y="390" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="generic-desc" value="&lt;b&gt;CRUD oder Zukauf (CRM, E-Mail, Kalender)&lt;/b&gt;&lt;br/&gt;Kontaktmanagement, Aktivitaeten" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="490" y="400" width="420" height="100" as="geometry" />
        </mxCell>

        <!-- Arrows from blocks to descriptions -->
        <mxCell id="core-arrow" value="" style="endArrow=open;endFill=0;strokeColor=#82b366;strokeWidth=1;dashed=1;" edge="1" source="core-block" target="core-desc" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="supporting-arrow" value="" style="endArrow=open;endFill=0;strokeColor=#d6b656;strokeWidth=1;dashed=1;" edge="1" source="supporting-block" target="supporting-desc" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="generic-arrow" value="" style="endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=1;dashed=1;" edge="1" source="generic-block" target="generic-desc" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
