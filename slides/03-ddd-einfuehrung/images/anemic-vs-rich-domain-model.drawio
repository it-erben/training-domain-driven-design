<mxfile host="draw.io">
  <diagram name="Anemic vs Rich Domain Model" id="anemic-rich-1">
    <mxGraphModel dx="1622" dy="862" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Anemic vs. Rich Domain Model" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== LEFT SIDE: ANEMIC MODEL ==================== -->

        <!-- Anemic container -->
        <mxCell id="anemic-container" value="" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="680" height="760" as="geometry" />
        </mxCell>

        <mxCell id="anemic-title" value="Anemic Domain Model" style="text;html=1;fontSize=18;fontStyle=1;align=center;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="170" y="90" width="460" height="35" as="geometry" />
        </mxCell>
        <mxCell id="anemic-warning" value="Anti-Pattern!" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="270" y="120" width="260" height="25" as="geometry" />
        </mxCell>

        <!-- Anemic Entity: Vermittlungsvorgang -->
        <mxCell id="anemic-entity" value="&lt;b&gt;Vermittlungsvorgang&lt;/b&gt;&lt;br/&gt;(Entity – nur Datencontainer)&lt;hr size=&quot;1&quot;/&gt;- id: UUID&lt;br/&gt;- status: Status&lt;br/&gt;- maklervertragId: UUID&lt;br/&gt;- interessenten: List&amp;lt;Interessent&amp;gt;&lt;br/&gt;- besichtigungen: List&amp;lt;Besichtigung&amp;gt;&lt;br/&gt;- angebote: List&amp;lt;Angebot&amp;gt;&lt;hr size=&quot;1&quot;/&gt;+ getId(): UUID&lt;br/&gt;+ setId(id): void&lt;br/&gt;+ getStatus(): Status&lt;br/&gt;+ setStatus(s): void&lt;br/&gt;+ getInteressenten(): List&lt;br/&gt;+ setInteressenten(list): void&lt;br/&gt;+ getBesichtigungen(): List&lt;br/&gt;+ setBesichtigungen(list): void&lt;br/&gt;+ getAngebote(): List&lt;br/&gt;+ setAngebote(list): void" style="html=1;shape=mxgraph.unified_modeling_language.class;verticalAlign=top;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="120" y="160" width="280" height="370" as="geometry" />
        </mxCell>

        <mxCell id="anemic-note1" value="Nur Getter/Setter!&lt;br/&gt;Keine Geschaeftslogik!" style="html=1;shape=note;whiteSpace=wrap;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="450" y="190" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="anemic-note1-edge" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;dashed=1;endArrow=none;" edge="1" source="anemic-note1" target="anemic-entity" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Anemic Service: VermittlungService -->
        <mxCell id="anemic-service" value="&lt;b&gt;VermittlungService&lt;/b&gt;&lt;br/&gt;(Domain Service – gesamte Logik hier!)&lt;hr size=&quot;1&quot;/&gt;- repository: VermittlungsvorgangRepository&lt;hr size=&quot;1&quot;/&gt;+ interessentHinzufuegen(id, interessent): void&lt;br/&gt;+ besichtigungDurchfuehren(id, termin): void&lt;br/&gt;+ angebotAbgeben(id, angebot): void&lt;br/&gt;+ angebotAnnehmen(id, angebotId): void&lt;br/&gt;+ angebotAblehnen(id, angebotId): void&lt;br/&gt;+ vermittlungAbschliessen(id): void&lt;br/&gt;+ statusPruefen(id): Status&lt;br/&gt;+ validateStatus(vorgang): void&lt;br/&gt;+ berechneProvision(vorgang): BigDecimal" style="html=1;shape=mxgraph.unified_modeling_language.class;verticalAlign=top;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="110" y="570" width="310" height="240" as="geometry" />
        </mxCell>

        <mxCell id="anemic-note2" value="Alle Geschaeftslogik&lt;br/&gt;im Service!&lt;br/&gt;Entity ist nur ein&lt;br/&gt;Daten-Sack." style="html=1;shape=note;whiteSpace=wrap;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="470" y="610" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="anemic-note2-edge" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;dashed=1;endArrow=none;" edge="1" source="anemic-note2" target="anemic-service" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Service uses Entity -->
        <mxCell id="anemic-svc-to-ent" value="manipuliert&lt;br/&gt;direkt Felder" style="html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;endArrow=open;endFill=0;fontSize=10;" edge="1" source="anemic-service" target="anemic-entity" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== DIVIDER ==================== -->
        <mxCell id="divider" value="" style="line;strokeColor=#999999;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="80" width="1" height="760" as="geometry" />
        </mxCell>
        <mxCell id="vs-label" value="VS." style="text;html=1;fontSize=20;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="765" y="430" width="50" height="30" as="geometry" />
        </mxCell>

        <!-- ==================== RIGHT SIDE: RICH DOMAIN MODEL ==================== -->

        <!-- Rich container -->
        <mxCell id="rich-container" value="" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;dashed=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="840" y="80" width="700" height="760" as="geometry" />
        </mxCell>

        <mxCell id="rich-title" value="Rich Domain Model" style="text;html=1;fontSize=18;fontStyle=1;align=center;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="990" y="90" width="400" height="35" as="geometry" />
        </mxCell>
        <mxCell id="rich-best" value="Best Practice!" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1060" y="120" width="260" height="25" as="geometry" />
        </mxCell>

        <!-- Rich Entity: Vermittlungsvorgang -->
        <mxCell id="rich-entity" value="&lt;b&gt;Vermittlungsvorgang&lt;/b&gt;&lt;br/&gt;(Aggregate Root – reich an Verhalten)&lt;hr size=&quot;1&quot;/&gt;- id: UUID&lt;br/&gt;- status: Status&lt;br/&gt;- maklervertragId: UUID&lt;br/&gt;- interessenten: List&amp;lt;Interessent&amp;gt;&lt;br/&gt;- besichtigungen: List&amp;lt;Besichtigung&amp;gt;&lt;br/&gt;- angebote: List&amp;lt;Angebot&amp;gt;&lt;hr size=&quot;1&quot;/&gt;+ interessentHinzufuegen(interessent): void&lt;br/&gt;+ besichtigungDurchfuehren(termin): Besichtigung&lt;br/&gt;+ angebotAbgeben(angebot): void&lt;br/&gt;+ angebotAnnehmen(angebotId): void&lt;br/&gt;+ angebotAblehnen(angebotId): void&lt;br/&gt;+ abschliessen(): void&lt;br/&gt;+ berechneProvision(): BigDecimal&lt;br/&gt;- validateStatus(expected: Status): void&lt;br/&gt;- assertNichtAbgeschlossen(): void" style="html=1;shape=mxgraph.unified_modeling_language.class;verticalAlign=top;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;align=left;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="910" y="160" width="330" height="380" as="geometry" />
        </mxCell>

        <mxCell id="rich-note1" value="Geschaeftslogik &amp;amp;&lt;br/&gt;Invarianten direkt&lt;br/&gt;in der Entity!&lt;br/&gt;&lt;b&gt;Tell, Don't Ask!&lt;/b&gt;" style="html=1;shape=note;whiteSpace=wrap;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="1290" y="200" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rich-note1-edge" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;dashed=1;endArrow=none;" edge="1" source="rich-note1" target="rich-entity" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rich Application Service: VermittlungAppService -->
        <mxCell id="rich-app-service" value="&lt;b&gt;VermittlungAppService&lt;/b&gt;&lt;br/&gt;(Application Service – nur Orchestrierung)&lt;hr size=&quot;1&quot;/&gt;- repository: VermittlungsvorgangRepository&lt;br/&gt;- eventPublisher: ApplicationEventPublisher&lt;hr size=&quot;1&quot;/&gt;+ besichtigungDurchfuehren(id, termin): void {&lt;br/&gt;&amp;nbsp;&amp;nbsp;var v = repository.findById(id);&lt;br/&gt;&amp;nbsp;&amp;nbsp;v.besichtigungDurchfuehren(termin); // delegate!&lt;br/&gt;&amp;nbsp;&amp;nbsp;repository.save(v);&lt;br/&gt;}" style="html=1;shape=mxgraph.unified_modeling_language.class;verticalAlign=top;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="900" y="590" width="350" height="200" as="geometry" />
        </mxCell>

        <mxCell id="rich-note2" value="Duenne Schicht:&lt;br/&gt;1. Laden&lt;br/&gt;2. Delegieren&lt;br/&gt;3. Speichern" style="html=1;shape=note;whiteSpace=wrap;size=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="1300" y="630" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rich-note2-edge" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;dashed=1;endArrow=none;" edge="1" source="rich-note2" target="rich-app-service" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: AppService delegates to Entity -->
        <mxCell id="rich-svc-to-ent" value="delegiert an&lt;br/&gt;(load, delegate, save)" style="html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;endArrow=open;endFill=0;fontSize=10;" edge="1" source="rich-app-service" target="rich-entity" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
