<mxfile host="draw.io">
  <diagram name="Bounded Context Immobilie Vergleich" id="bc-immobilie-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Left box: BC Objektverwaltung (blue) -->
        <mxCell id="bc-left" value="&lt;b style=&quot;font-size:15px;&quot;&gt;BC: Objektverwaltung&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&quot;Immobilie&quot; =&lt;/b&gt;&lt;br/&gt;Stammdaten, Lage,&lt;br/&gt;Bewertung, Grundriss&lt;br/&gt;&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;Detailliertes&lt;br/&gt;technisches Modell&lt;/b&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;verticalAlign=top;align=center;spacingTop=10;spacingLeft=10;spacingRight=10;spacingBottom=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="400" height="280" as="geometry" />
        </mxCell>

        <!-- Right box: BC Vermarktung (orange/yellow) -->
        <mxCell id="bc-right" value="&lt;b style=&quot;font-size:15px;&quot;&gt;BC: Vermarktung&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&quot;Immobilie&quot; =&lt;/b&gt;&lt;br/&gt;Expose-Text, Fotos,&lt;br/&gt;Zielgruppe, Portale&lt;br/&gt;&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;Marketingorientiert&lt;br/&gt;fuer den Interessenten&lt;/b&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;verticalAlign=top;align=center;spacingTop=10;spacingLeft=10;spacingRight=10;spacingBottom=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="400" height="280" as="geometry" />
        </mxCell>

        <!-- "Gleicher Begriff" annotation -->
        <mxCell id="same-term-label" value="&lt;b&gt;Gleicher Begriff &quot;Immobilie&quot; &amp;ndash; unterschiedliche Bedeutung!&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="440" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- Dashed line connecting both boxes -->
        <mxCell id="connect-line" value="" style="endArrow=none;strokeColor=#999999;strokeWidth=2;dashed=1;" edge="1" source="bc-left" target="bc-right" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Not-equal symbol between boxes -->
        <mxCell id="neq-label" value="&lt;b&gt;&#x2260;&lt;/b&gt;" style="text;html=1;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="520" y="230" width="60" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
