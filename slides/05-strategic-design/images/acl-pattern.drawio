<mxfile host="draw.io">
  <diagram name="ACL Pattern" id="acl-pattern">
    <mxGraphModel dx="1024" dy="768" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Left box: External CRM (Upstream) - pink -->
        <mxCell id="2" value="&lt;b&gt;External CRM&lt;/b&gt;&lt;br&gt;(Upstream)&lt;br&gt;&lt;br&gt;&amp;quot;Customer&amp;quot;&lt;br&gt;&amp;quot;Account&amp;quot;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=12;spacingTop=5;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="190" height="150" as="geometry"/>
        </mxCell>
        <!-- Middle box: ACL Translator - yellow -->
        <mxCell id="3" value="&lt;b&gt;ACL&lt;/b&gt;&lt;br&gt;Translator&lt;br&gt;&lt;br&gt;Customer&lt;br&gt;&amp;rarr; Contact" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=12;spacingTop=5;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="330" y="60" width="170" height="150" as="geometry"/>
        </mxCell>
        <!-- Right box: Contact Management (Downstream) - green -->
        <mxCell id="4" value="&lt;b&gt;Contact&lt;br&gt;Management&lt;/b&gt;&lt;br&gt;(Downstream)&lt;br&gt;&lt;br&gt;&amp;quot;Contact&amp;quot;&lt;br&gt;&amp;quot;Owner&amp;quot;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=12;spacingTop=5;spacingBottom=5;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="190" height="150" as="geometry"/>
        </mxCell>
        <!-- Arrow: External CRM -> ACL -->
        <mxCell id="5" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Arrow: ACL -> Contact Management -->
        <mxCell id="6" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
