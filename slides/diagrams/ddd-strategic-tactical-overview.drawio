        <!-- S1: Bounded Context -->
        <mxCell id="s1" value="&lt;b&gt;Bounded Context&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Fachliche Grenze mit eigenem Modell&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
