        <!-- Adapter label -->
        <mxCell id="adapter-label" value="&amp;laquo;Adapter&amp;raquo;" style="text;html=1;fontSize=12;fontStyle=2;align=center;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="520" y="605" width="160" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
