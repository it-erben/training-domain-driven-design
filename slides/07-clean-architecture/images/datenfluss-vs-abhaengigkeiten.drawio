<mxfile host="draw.io">
  <diagram name="Datenfluss vs Abhaengigkeitsrichtung" id="dataflow-deps-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== TOP SECTION: Datenfluss ==================== -->
        <mxCell id="section1-title" value="&lt;b&gt;Datenfluss (Request)&lt;/b&gt;" style="text;html=1;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="300" height="35" as="geometry" />
        </mxCell>

        <!-- Controller box -->
        <mxCell id="df-controller" value="&lt;b&gt;Controller&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Use Case box -->
        <mxCell id="df-usecase" value="&lt;b&gt;Use Case&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="90" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Repository Port box -->
        <mxCell id="df-repo" value="&lt;b&gt;Repository Port&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="90" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- DB box -->
        <mxCell id="df-db" value="&lt;b&gt;DB&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1050" y="80" width="120" height="70" as="geometry" />
        </mxCell>

        <!-- Dataflow arrows (left to right) -->
        <mxCell id="df-arrow1" value="" style="endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="120" as="sourcePoint" />
            <mxPoint x="400" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="df-arrow2" value="" style="endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="120" as="sourcePoint" />
            <mxPoint x="720" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="df-arrow3" value="" style="endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="120" as="sourcePoint" />
            <mxPoint x="1050" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Layer labels below dataflow -->
        <mxCell id="df-lbl-adapter" value="Adapter" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="110" y="158" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="df-lbl-app" value="Application" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="158" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="df-lbl-domain" value="Domain" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="750" y="158" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="df-lbl-infra" value="Infrastructure" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1045" y="158" width="120" height="20" as="geometry" />
        </mxCell>

        <!-- Separator line -->
        <mxCell id="separator" value="" style="endArrow=none;strokeColor=#cccccc;strokeWidth=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="50" y="220" as="sourcePoint" />
            <mxPoint x="1250" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== BOTTOM SECTION: Abhängigkeiten ==================== -->
        <mxCell id="section2-title" value="&lt;b&gt;Abhängigkeiten&lt;/b&gt;" style="text;html=1;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="250" width="300" height="35" as="geometry" />
        </mxCell>

        <!-- Controller box -->
        <mxCell id="dep-controller" value="&lt;b&gt;Controller&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="310" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Use Case box -->
        <mxCell id="dep-usecase" value="&lt;b&gt;Use Case&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="310" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Repository Adapter box -->
        <mxCell id="dep-adapter" value="&lt;b&gt;Repository Adapter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="310" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Domain Model box -->
        <mxCell id="dep-domain" value="&lt;b&gt;Domain Model&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="450" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Dependency arrows (pointing inward toward Use Case / Domain) -->
        <!-- Controller -> Use Case -->
        <mxCell id="dep-arrow1" value="" style="endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="340" as="sourcePoint" />
            <mxPoint x="500" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Repository Adapter -> Use Case (arrow points LEFT = inward) -->
        <mxCell id="dep-arrow2" value="" style="endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="340" as="sourcePoint" />
            <mxPoint x="680" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Use Case -> Domain Model -->
        <mxCell id="dep-arrow3" value="" style="endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="590" y="370" as="sourcePoint" />
            <mxPoint x="590" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Annotation: key insight -->
        <mxCell id="insight-box" value="&lt;b&gt;Daten&lt;/b&gt; fließen durch alle Schichten&lt;br&gt;&lt;b&gt;Abhängigkeiten&lt;/b&gt; zeigen nur nach innen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="430" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Arrow labels -->
        <mxCell id="dep-arrow2-label" value="&lt;i&gt;implements Port&lt;/i&gt;" style="text;html=1;fontSize=10;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="720" y="315" width="140" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
