          <mxGeometry x="504" y="360" width="160" height="55" as="geometry" />
        </mxCell>

        <!-- Dependency arrow: Outer -> Inner (Adapter implements Port) -->
        <mxCell id="dep-arrow" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=3;endArrow=block;endFill=1;dashed=1;" edge="1" source="adapter-box" target="port-box" parent="1">
